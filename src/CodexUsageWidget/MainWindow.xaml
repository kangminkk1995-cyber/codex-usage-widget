<Window x:Class="CodexUsageWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex 用量"
        Width="204" Height="76"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        FontFamily="{StaticResource UiFont}"
        MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave"
        Closing="Window_Closing" Loaded="Window_Loaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#AAB4C8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#22334B" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="WidgetRoot">
        <Border x:Name="CompactCard" Width="180" Height="52" Margin="12" Padding="10,7"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                CornerRadius="14" Background="#F2131A26" BorderBrush="#324158" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.46" Color="#000000" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="3" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="28" Height="28">
                        <Border CornerRadius="8" Background="#173E73">
                            <TextBlock Text="C" Foreground="#7FC4FF" FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Ellipse Width="6" Height="6" Fill="{Binding FreshnessBrush, Mode=OneWay}"
                                 Stroke="#131A26" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top" />
                    </Grid>
                    <TextBlock Grid.Column="1" Text="Codex" Margin="8,0,0,0" Foreground="#DCE5F4"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Foreground="{Binding CompactStatusBrush, Mode=OneWay}"
                               FontSize="17" FontWeight="Bold" VerticalAlignment="Center">
                        <Run Text="{Binding CompactRemainingText, Mode=OneWay}"/><Run Text="{Binding CompactRemainingSuffix, Mode=OneWay}"/>
                    </TextBlock>
                </Grid>
                <Grid Grid.Row="1" Margin="0,3,0,0" ClipToBounds="True">
                    <Border Background="#283447" CornerRadius="2" />
                    <ProgressBar Value="{Binding CompactRemainingPercent, Mode=OneWay}" Maximum="100"
                                 Foreground="{Binding CompactStatusBrush, Mode=OneWay}"
                                 Background="Transparent" BorderThickness="0" />
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="ExpandedCard" Width="344" Margin="12" Padding="18"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                CornerRadius="18" Background="#F2131A26" BorderBrush="#324158" BorderThickness="1"
                Opacity="0" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="#000000" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="10" Background="#173E73">
                        <TextBlock Text="C" Foreground="#7FC4FF" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Codex 用量" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="实时额度监视器" Foreground="#7F8DA5" FontSize="11" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Content="↻" ToolTip="立即刷新" Click="Refresh_Click" />
                        <Button Style="{StaticResource IconButton}" Content="—" ToolTip="隐藏到托盘" Click="Hide_Click" />
                    </StackPanel>
                </Grid>

                <ItemsControl Grid.Row="1" Margin="0,14,0,0" ItemsSource="{Binding Quotas, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10" Padding="13" CornerRadius="12" Background="#151F2E">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{Binding Name, Mode=OneWay}" Foreground="#CED6E5" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock HorizontalAlignment="Right" Foreground="{Binding StatusBrush, Mode=OneWay}" FontWeight="Bold" FontSize="20">
                                            <Run Text="{Binding RemainingText, Mode=OneWay}"/><Run Text="%"/>
                                        </TextBlock>
                                    </Grid>
                                    <Grid Height="7" Margin="0,11,0,9" ClipToBounds="True">
                                        <Border Background="#283447" CornerRadius="4" />
                                        <ProgressBar Value="{Binding RemainingPercent, Mode=OneWay}" Maximum="100"
                                                     Foreground="{Binding StatusBrush, Mode=OneWay}"
                                                     Background="Transparent" BorderThickness="0" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="{Binding WindowText, Mode=OneWay}" Foreground="#76849A" FontSize="11" />
                                        <StackPanel HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding CountdownText, Mode=OneWay}" Foreground="#B9C3D5" FontSize="11" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding ResetTimeText, Mode=OneWay}" Foreground="#64738A" FontSize="10"
                                                       HorizontalAlignment="Right" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Row="1" Margin="0,14,0,6" Padding="16" CornerRadius="12" Background="#151F2E"
                        Visibility="{Binding ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="正在连接 Codex 实时额度" Foreground="#D8E0EE" FontSize="14"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="若实时接口暂不可用，将自动读取最近的本地记录。" Foreground="#78869D" FontSize="11"
                                   Margin="0,7,0,0" TextWrapping="Wrap" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Padding="12,9" CornerRadius="10" Background="#12243B"
                        Visibility="{Binding ShowCredits, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <TextBlock Text="Credits" Foreground="#91A4BE" FontSize="12" />
                        <TextBlock Text="{Binding CreditsText, Mode=OneWay}" Foreground="#70B9FF" FontSize="13"
                                   FontWeight="SemiBold" HorizontalAlignment="Right" />
                    </Grid>
                </Border>

                <Grid Grid.Row="3" Margin="2,9,2,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{Binding FreshnessBrush, Mode=OneWay}"
                                 Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusText, Mode=OneWay}" Foreground="#718096" FontSize="10" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding LastUpdatedText, Mode=OneWay}" Foreground="#5F6D82" FontSize="10" HorizontalAlignment="Right" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
