<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CodexUsageWidgetSetup</AssemblyName>
    <RootNamespace>CodexUsageWidget.Installer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\CodexUsageWidget\Assets\CodexUsageWidget.ico</ApplicationIcon>
    <DebugType>embedded</DebugType>
    <Version>1.1.0</Version>
  </PropertyGroup>
  <ItemGroup Condition="'$(PayloadZip)' != '' and Exists('$(PayloadZip)')">
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="CodexUsageWidget.Payload" />
  </ItemGroup>
</Project>
